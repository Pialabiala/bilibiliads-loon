[Plugin]
#!name=Bilibili 去广告
#!desc=清理开屏缓存、首页推荐广告及资源推广模块
#!author=Pialabiala
#!homepage=https://github.com/Pialabiala/bilibiliads-loon
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Bilibili.png
#!date=2026-10-31

[Rule]
DOMAIN,data.bilibili.com,REJECT
DOMAIN,dataflow.biliapi.com,REJECT
DOMAIN,cm.bilibili.com,REJECT
URL-REGEX,^https?://i[0-9]+\.hdslb\.com/bfs/sycp_brand/,REJECT

[Script]
http-response ^https?://app\.bilibili\.com/x/(v2/(splash/|feed/index)|resource/(peak/download|show)) script-path=https://raw.githubusercontent.com/Pialabiala/bilibiliads-loon/main/bilibili.js, requires-body=true, timeout=10, tag=Bilibili_Ads

[MITM]
hostname = app.bilibili.com
