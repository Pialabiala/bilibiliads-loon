[Plugin]
#!name=Bilibili 去广告
#!desc=移除哔哩哔哩开屏、信息流、会员购及部分 UI 推广模块，并拦截数据上报。
#!author=Pialabiala
#!homepage=https://github.com/Pialabiala/bilibiliads-loon
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Bilibili.png
#!date=2026-10-30

[Rule]
DOMAIN,data.bilibili.com,REJECT
DOMAIN,dataflow.biliapi.com,REJECT
DOMAIN-SUFFIX,cm.bilibili.com,REJECT
DOMAIN,manga.bilibili.com,REJECT
DOMAIN,api.bilibili.com,REJECT-DROP

[Script]
# 正则中新增了 show/tab 路径用于处理底部导航栏
http-response ^https?:\/\/app\.bilibili\.com\/x\/(v2\/(splash|feed\/index|account\/mine)|resource\/(peak\/download|show\/tab)) script-path=bilibili.js, requires-body=true, timeout=10, tag=Bilibili_Ads

[MITM]
hostname = app.bilibili.com
